--cpu Cortex-M3
"smart_locker\startup_stm32f103xb.o"
"smart_locker\fonts.o"
"smart_locker\rc522.o"
"smart_locker\st7789.o"
"smart_locker\main.o"
"smart_locker\stm32f1xx_it.o"
"smart_locker\stm32f1xx_hal_msp.o"
"smart_locker\stm32f1xx_hal_gpio_ex.o"
"smart_locker\stm32f1xx_hal_rtc.o"
"smart_locker\stm32f1xx_hal_rtc_ex.o"
"smart_locker\stm32f1xx_hal.o"
"smart_locker\stm32f1xx_hal_rcc.o"
"smart_locker\stm32f1xx_hal_rcc_ex.o"
"smart_locker\stm32f1xx_hal_gpio.o"
"smart_locker\stm32f1xx_hal_dma.o"
"smart_locker\stm32f1xx_hal_cortex.o"
"smart_locker\stm32f1xx_hal_pwr.o"
